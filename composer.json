{
  "name": "creativestyle/mageops-node-warmer",
  "description": "Warms up local node cache and regenerates redis cache if new code version was deployed",
  "type": "magento2-module",
  "homepage": "https://creativestyle.de",
  "license": "OSL-3.0",
  "require": {
    "symfony/stopwatch": "^5.0 || ^6.0 || ^7.0",
    "psr/log": "^3.0",
    "monolog/monolog": "^3.0"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "MageOps\\NodeWarmer\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
